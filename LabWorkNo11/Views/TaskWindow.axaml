<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabWorkNo11.ViewModels"
        x:Class="LabWorkNo11.Views.TaskWindow"
        x:DataType="vm:TaskViewModel"
        Title="Завдання" Width="300" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Назва:"/>
        <TextBox Text="{Binding Title, Mode=TwoWay}"/>
        
        <TextBlock Text="Опис:"/>
        <TextBox Text="{Binding Description, Mode=TwoWay}" Height="60" AcceptsReturn="True"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Скасувати" Command="{Binding CancelCommand}" Click="OnCancelClick"/>
            <Button Content="Зберегти" Command="{Binding SaveCommand}" Click="OnSaveClick" Background="LightBlue"/>
        </StackPanel>
    </StackPanel>
</Window>
<!-- -->